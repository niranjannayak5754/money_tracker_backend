# App
APP_ENV=development
HTTP_ADDR=:8080
MONGO_URI=mongodb://mongo:27017
MONGO_DB=money_tracker
JWT_SECRET=REPLACE_ME_GENERATE_WITH_openssl_rand_hex_32

# Comma-separated. Must include the UI's origin (dev and prod) or the
# browser will get CORS-blocked. Defaults to http://localhost:3000 if unset.
ALLOWED_ORIGINS=http://localhost:3000

# IANA timezone used to interpret date-only strings (e.g. "2026-07-04")
# that don't carry a UTC offset. Defaults to Asia/Kolkata if unset.
APP_TIMEZONE=Asia/Kolkata
